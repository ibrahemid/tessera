---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  sizes?: string;
  eager?: boolean;
}
const { src, alt, class: cls = "", sizes = "(min-width: 900px) 40vw, 92vw", eager = false } = Astro.props;
const widths = [Math.round(src.width / 2), src.width];
---
<figure class:list={["still", cls]}>
  <Image src={src} alt={alt} widths={widths} sizes={sizes} format="webp" quality={88} loading={eager ? "eager" : "lazy"} style={`max-width: ${src.width}px`} />
</figure>

<style>
  .still { margin: 0; line-height: 0; }
  .still :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--band-line);
  }
</style>
