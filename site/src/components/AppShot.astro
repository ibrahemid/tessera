---
import { Image } from "astro:assets";
import light from "../assets/app-vault-light.png";
import dark from "../assets/app-vault-dark.png";

interface Props {
  class?: string;
  sizes?: string;
}
const { class: cls = "", sizes = "(min-width: 900px) 44vw, 92vw" } = Astro.props;
const alt = "Tessera's main window: five accounts with live codes and countdown rings, GitHub pinned at the top";
---
<figure class:list={["app-shot", cls]}>
  <Image src={light} alt={alt} widths={[381, 762]} sizes={sizes} format="webp" quality={90} class="shot shot-light" loading="lazy" />
  <Image src={dark} alt={alt} widths={[381, 762]} sizes={sizes} format="webp" quality={90} class="shot shot-dark" loading="lazy" />
</figure>

<style>
  .app-shot { margin: 0; line-height: 0; }
  .shot {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 14px;
    box-shadow: 0 1px 0 var(--line-strong), 0 40px 90px -40px rgba(23, 24, 29, 0.45);
  }
  .shot-dark { display: none; }
  :global(html.dark) .shot-light { display: none; }
  :global(html.dark) .shot-dark { display: block; }
</style>
