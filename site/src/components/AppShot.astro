---
import { Image } from "astro:assets";
import light from "../assets/app-vault-light.png";
import dark from "../assets/app-vault-dark.png";

interface Props {
  class?: string;
  sizes?: string;
  bleed?: boolean;
}
const { class: cls = "", sizes = "(min-width: 900px) 48vw, 92vw", bleed = false } = Astro.props;
const alt = "Tessera's main window: a sidebar with All, Pinned and a Work folder, and five accounts with live codes and countdown rings";
---
<figure class:list={["app-shot", cls, { bleed }]}>
  <Image src={light} alt={alt} widths={[720, 1440]} sizes={sizes} format="webp" quality={90} class="shot shot-light" loading="lazy" />
  <Image src={dark} alt={alt} widths={[720, 1440]} sizes={sizes} format="webp" quality={90} class="shot shot-dark" loading="lazy" />
</figure>

<style>
  .app-shot { margin: 0; line-height: 0; overflow: hidden; }
  .shot {
    display: block;
    width: 100%;
    max-width: 720px;
    height: auto;
    border-radius: 10px;
    box-shadow: 0 0 0 1px var(--line-strong);
  }
  @media (min-width: 900px) {
    .bleed .shot { width: min(calc(100% + 1.25rem), 720px); max-width: none; border-radius: 10px 0 0 10px; }
  }
  .shot-dark { display: none; }
  :global(html.dark) .shot-light { display: none; }
  :global(html.dark) .shot-dark { display: block; }
</style>
