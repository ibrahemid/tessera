---
import "@fontsource-variable/schibsted-grotesk";
import "@fontsource-variable/hanken-grotesk";
import "@fontsource/ibm-plex-mono/400.css";
import "../styles/global.css";
import Wordmark from "../components/Wordmark.astro";

interface Props {
  title?: string;
  description?: string;
  current?: string;
  preloadImage?: string;
}

const {
  title = "Tessera — 2FA in your terminal and your Mac",
  description = "A two-factor authenticator for macOS: a native app and the tess command line on one documented vault format. Offline, no account, open source.",
  current = "",
  preloadImage,
} = Astro.props;
const year = 2026;
const site = "https://tessera.ibrahemid.com";
const repo = "https://github.com/ibrahemid/tessera";
const appStore = "https://apps.apple.com/app/tessera-2fa-authenticator/id6788814172";

const nav = [
  ["/cli", "CLI"],
  ["/security", "Security"],
  ["/changelog", "Changelog"],
  [repo, "GitHub"],
];

const footer = [
  ["Product", [
    [appStore, "Mac App Store"],
    ["/#install", "Install"],
    ["/#app", "The app"],
    ["/changelog", "Changelog"],
    ["/press", "Press kit"],
  ]],
  ["CLI", [
    ["/cli", "tess reference"],
    ["/cli#json", "JSON output"],
    ["/cli#completions", "Shell completions"],
    [`${repo}/releases`, "Releases"],
  ]],
  ["Source", [
    [repo, "Repository"],
    ["/vault-format", "Vault format"],
    ["/security", "Security"],
    [`${repo}/blob/main/.github/workflows/ci.yml`, "CI"],
    [`${repo}/blob/main/LICENSE`, "Apache-2.0"],
  ]],
  ["Help", [
    ["/support", "Support"],
    ["/learn", "New to 2FA"],
    ["/vs/ente", "Tessera vs Ente Auth"],
    ["/vs/authy", "Tessera vs Authy"],
    ["/privacy", "Privacy"],
    ["mailto:support@ibrahemid.com", "support@ibrahemid.com"],
  ]],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0f13" media="(prefers-color-scheme: dark)" />
    <meta name="apple-itunes-app" content="app-id=6788814172" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, site)} />
    <meta property="og:image" content={`${site}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${site}/og.png`} />
    <link rel="canonical" href={new URL(Astro.url.pathname, site)} />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <script defer src="https://stats.ibrahemid.com/script.js" data-website-id="9b1c6322-ec64-4e26-9b0d-0ac47526cb0a" data-domains="tessera.ibrahemid.com"></script>
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("tessera-theme");
          const dark = stored ? stored === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
          if (dark) document.documentElement.classList.add("dark");
        } catch (_) {}
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:rounded-lg focus:bg-surface focus:border focus:border-line"
      >Skip to content</a
    >

    <header class="site-header">
      <div class="mx-auto w-full max-w-[1600px] h-16 flex items-center justify-between" style="padding-inline: var(--gap)">
        <a href="/" class="flex items-center gap-2.5" aria-label="Tessera home">
          <Wordmark />
        </a>
        <nav class="site-nav flex items-center gap-0.5 sm:gap-1" aria-label="Site">
          {nav.map(([href, label]) => (
            <a
              href={href}
              class={href.startsWith("http") ? "" : "hidden sm:inline"}
              aria-current={current && href === current ? "page" : undefined}
              rel={href.startsWith("http") ? "noopener" : undefined}
            >{label}</a>
          ))}
          <a href="/#install" class="btn btn-gold ml-2" style="height: 2.3rem; padding-inline: 0.9rem; font-size: 0.88rem">Get Tessera</a>
          <button
            id="theme-toggle"
            type="button"
            class="ml-1 grid place-items-center w-9 h-9 rounded-lg border border-line hover:border-[var(--gold)] transition-colors"
            aria-label="Toggle color theme"
          >
            <svg class="theme-sun w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.4 1.4M17.6 17.6 19 19M5 19l1.4-1.4M17.6 6.4 19 5" />
            </svg>
            <svg class="theme-moon w-[18px] h-[18px] hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main" class="page flex-1 w-full">
      <slot />
    </main>

    <footer class="site-footer band-ink">
      <div class="mx-auto w-full max-w-[1600px] py-14" style="padding-inline: var(--gap)">
        <div class="grid gap-10 md:grid-cols-[1.2fr_repeat(4,1fr)]">
          <div>
            <Wordmark />
            <a href={appStore} rel="noopener" class="inline-block mt-5" aria-label="Download on the Mac App Store">
              <img src="/mac-app-store-badge.svg" alt="" width="156" height="40" class="badge-store" style="height: 2.5rem" />
            </a>
          </div>
          {footer.map(([heading, links]) => (
            <nav aria-label={heading}>
              <p class="h-small" style="font-family: var(--font-display); font-weight: 700; font-size: 0.95rem">{heading}</p>
              <ul class="mt-3 space-y-1.5 text-sm">
                {links.map(([href, label]) => (
                  <li><a href={href} rel={href.startsWith("http") ? "noopener" : undefined}>{label}</a></li>
                ))}
              </ul>
            </nav>
          ))}
        </div>
        <div class="mt-12 pt-6 border-t flex flex-wrap items-center justify-between gap-3 text-xs faint" style="border-color: var(--band-line)">
          <span>© {year} Tessera · Apache-2.0</span>
          <span class="mono">tess 1.0.2 · app 1.0.2 · macOS 14+</span>
        </div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const btn = document.getElementById("theme-toggle");
        const root = document.documentElement;
        const sun = btn?.querySelector(".theme-sun");
        const moon = btn?.querySelector(".theme-moon");
        const sync = () => {
          const dark = root.classList.contains("dark");
          sun?.classList.toggle("hidden", dark);
          moon?.classList.toggle("hidden", !dark);
        };
        sync();
        btn?.addEventListener("click", () => {
          const dark = root.classList.toggle("dark");
          try { localStorage.setItem("tessera-theme", dark ? "dark" : "light"); } catch (_) {}
          sync();
        });
        document.querySelectorAll("[data-copy]").forEach((el) => {
          el.addEventListener("click", async () => {
            try {
              await navigator.clipboard.writeText(el.getAttribute("data-copy") || "");
              const prev = el.textContent;
              el.textContent = "Copied";
              setTimeout(() => { el.textContent = prev; }, 1400);
            } catch (_) {}
          });
        });
      })();
    </script>
  </body>
</html>
