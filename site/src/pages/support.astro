---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import AppShot from "../components/AppShot.astro";
const repo = "https://github.com/ibrahemid/tessera";

const faqs = [
  ["How do I import my existing accounts?", "From Google Authenticator: Transfer accounts, Export, then scan the QR (app) or run tess import --migration \"otpauth-migration://…\". You can also paste otpauth links, or import a file of many at once, including Aegis, 2FAS and Raivo exports."],
  ["Where are my codes stored?", "In an encrypted vault on your Mac. The app keeps it in its sandbox container; the CLI keeps it at ~/.local/share/tessera/vault.json. To use one vault for both, choose Open existing vault in the app and pick the CLI's file; the app remembers it."],
  ["I forgot my passphrase.", "The vault cannot be decrypted without it. Keep a backup with tess export --file backup.json and store your passphrase somewhere safe, like a password manager."],
  ["Can I use it on more than one Mac?", "Yes. Move a vault between machines with tess export --file backup.json, then tess merge backup.json on the other side. For the CLI to open the app's own vault, set a recovery passphrase in the app's settings, then point TESSERA_VAULT or --vault at that file."],
  ["Is it really free?", "Yes. Apache-2.0 licensed, nothing to buy."],
  ["Which services work with Tessera?", "Any service that offers an authenticator app (TOTP), plus HOTP and Steam Guard. If you can scan its QR or copy its setup link, Tessera can hold it."],
  ["Is there a menu bar mode?", "Not in 1.0. Tessera is a windowed app; a status bar item is planned."],
];
---
<Base title="Support — Tessera" description="Help with Tessera: importing accounts, where the vault lives, sharing it between the app and the CLI, backups." current="/support">
  <PageHead kicker="Support" title="Help, and how it works.">
    The fastest way to report a bug or ask a question is a GitHub issue; for anything private, email works.
    New to two-factor codes? Start on <a href="/learn">/learn</a>.
    <AppShot slot="media" sizes="(min-width: 900px) 34vw, 80vw" />
  </PageHead>

  <div class="measure">
    <div class="flex flex-wrap gap-3">
      <a href={repo + "/issues"} rel="noopener" class="btn btn-gold">Open an issue</a>
      <a href="mailto:support@ibrahemid.com" class="btn btn-ghost">Email support</a>
    </div>

    <section class="mt-14 faq">
      <h2 class="h-sub">Common questions</h2>
      <div class="mt-6 rows">
        {faqs.map(([q, a]) => (
          <details class="row-details">
            <summary>{q}</summary>
            <p class="mt-3 soft">{a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</Base>

<style>
  .faq { padding-bottom: 6rem; }
  .row-details { border-bottom: 1px solid var(--line); padding: 1.1rem 0; }
  .row-details summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 1rem; font-family: var(--font-display); }
  .row-details summary::-webkit-details-marker { display: none; }
  .row-details summary::after { content: "+"; color: var(--gold); font-family: var(--font-mono); }
  .row-details[open] summary::after { content: "−"; }
</style>
