---
import Base from "../layouts/Base.astro";
import AppShot from "../components/AppShot.astro";

const repo = "https://github.com/ibrahemid/tessera";
const blob = `${repo}/blob/main`;
const appStore = "https://apps.apple.com/app/tessera-2fa-authenticator/id6788814172";

const cliVersion = "1.0.2";
const brewCmd = "brew install ibrahemid/tap/tess";
const curlCmd = "curl -fsSL https://raw.githubusercontent.com/ibrahemid/tessera/main/install.sh | sh";
const goCmd = "go install github.com/ibrahemid/tessera/go/cmd/tess@latest";
const releaseBase = `${repo}/releases/download/v${cliVersion}`;
const tarballs = [
  ["macOS, Apple silicon", `tess_${cliVersion}_darwin_arm64.tar.gz`, "f0b41aa4a75baf57dd6f55e9191e3dcac4761653f4fa2ca0ced85001810be18d"],
  ["macOS, Intel", `tess_${cliVersion}_darwin_amd64.tar.gz`, "16c16f0adb8bd967a4597b0d86cc7b6d2cafa2995c1539b64e757a69fc34a491"],
  ["Linux, arm64", `tess_${cliVersion}_linux_arm64.tar.gz`, "1988dcf8dcca0eafd3ae8d9b16dd978db799ff06464a841a46f2386df2f115fe"],
  ["Linux, x86_64", `tess_${cliVersion}_linux_amd64.tar.gz`, "3758e770c7da4547fb4e31e54fd97e5c9761468d4a356fe41ee3170ac52f838f"],
];

const pillars = [
  {
    h: "Canonical JSON",
    p: "Before encryption the account list is serialized one way only: keys sorted by UTF-8 byte order, Go's string escaping with HTML escaping off, no whitespace, integers only. Both cores produce the same bytes, so cross-decrypt can diff them.",
    links: [[`${blob}/spec/vault-format.md`, "spec/vault-format.md"], [`${blob}/spec/canonical_edge.json`, "spec/canonical_edge.json"]],
  },
  {
    h: "Shared vector suite",
    p: "spec/testvectors.json pins envelopes, wraps, codes and the edge cases. The Go tests, the swiftc verifier and the XCTest suite all read the same file; a change to one core that the other cannot open fails the vectors.",
    links: [[`${blob}/spec/testvectors.json`, "spec/testvectors.json"], [`${blob}/swift/Tools/verify/main.swift`, "swift/Tools/verify/main.swift"], [`${blob}/go/internal/spectest`, "go/internal/spectest"]],
  },
  {
    h: "CI cross-decrypt",
    p: "Every push runs the Go suite, compiles TesseraCore with swiftc against the vectors, and runs swift test, which decrypts a Go-written vault with real argon2id.",
    links: [[`${blob}/.github/workflows/ci.yml`, ".github/workflows/ci.yml"], [`${blob}/go/internal/vault/crossdecrypt_test.go`, "go/internal/vault/crossdecrypt_test.go"]],
  },
];

const security = [
  {
    t: "argon2id",
    d: "A passphrase wraps the vault key through argon2id at 128 MiB, t=3, p=4 with a 16-byte salt. Go uses golang.org/x/crypto; Swift uses the vendored PHC reference implementation, checked against the same known answer.",
    links: [[`${blob}/go/internal/vault/vault.go`, "go/internal/vault/vault.go"], [`${blob}/swift/Sources/CArgon2`, "swift/Sources/CArgon2"]],
  },
  {
    t: "XChaCha20-Poly1305",
    d: "A random 256-bit key encrypts the account payload with a fresh 24-byte nonce on every write. Each unlock method wraps that key separately, so adding or removing a method never re-encrypts the payload.",
    links: [[`${blob}/spec/vault-format.md`, "spec/vault-format.md"], [`${blob}/swift/Sources/TesseraCore/XChaCha.swift`, "swift/Sources/TesseraCore/XChaCha.swift"]],
  },
  {
    t: "Secure Enclave wrap",
    d: "The app wraps the key with a non-extractable Secure Enclave P-256 key (HKDF-SHA256 over a self key agreement). Require Touch ID adds the biometry access control. Set a recovery passphrase in Settings and the same file gains an argon2id wrap the CLI can open.",
    links: [[`${blob}/swift/App/Sources/SecureEnclaveWrap.swift`, "swift/App/Sources/SecureEnclaveWrap.swift"]],
  },
  {
    t: "No network entitlement",
    d: "The app's entitlements are App Sandbox, user-selected files and app-scoped bookmarks. There is no network entitlement, so the app cannot open a connection. The CLI imports no network package.",
    links: [[`${blob}/swift/App/Resources/Tessera.entitlements`, "swift/App/Resources/Tessera.entitlements"], [`${blob}/go/go.mod`, "go/go.mod"]],
  },
  {
    t: "Sandboxed",
    d: "The Mac app runs in the App Sandbox and ships through the Mac App Store, where its privacy label reads Data Not Collected. The vault it shares with the CLI is reached through a bookmark you grant once.",
    links: [[appStore, "App Store listing"], [`${blob}/swift/App/Resources/PrivacyInfo.xcprivacy`, "PrivacyInfo.xcprivacy"]],
  },
];

const others = [
  ["Ente Auth", "Free, open source, with end-to-end encrypted sync across devices. If you want sync everywhere, use it. Tessera is for staying local on a Mac and living in the terminal; Ente is not on the Mac App Store.", "/vs/ente"],
  ["Authy", "Tied to a phone number and an account, closed source, and its desktop app was discontinued in August 2024. Tessera has no account and stores a local file you own.", "/vs/authy"],
  ["2FAS", "Good on the phone. On a Mac it is a browser extension; Tessera is a native app plus a command line.", null],
  ["Raivo", "Was the open-source favorite on Apple platforms, then changed hands. Tessera's format is documented and export is one command, so leaving is always possible.", null],
  ["oathtool, pass-otp", "Real command-line tools, with secrets in plain files or gpg and no app. tess keeps the scriptability and adds an encrypted vault, Touch ID through the app, and a window when you want one.", null],
];

const softwareLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Tessera",
  applicationCategory: "SecurityApplication",
  operatingSystem: "macOS 14",
  url: "https://tessera.ibrahemid.com",
  downloadUrl: [appStore, `${repo}/releases`],
  installUrl: [appStore, `${repo}/releases`],
  softwareVersion: cliVersion,
  license: "https://www.apache.org/licenses/LICENSE-2.0",
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<Base current="/" preloadImage="/media/hero-poster.webp">
  <!-- ===== HERO: dark band, the real CLI on the right ===== -->
  <section class="band band-ink hero-band">
    <div class="u-bleed-right hero">
      <div class="hero-copy">
        <h1 class="h-display">Two-factor codes you actually own.</h1>
        <p class="lede mt-6 measure">
          An encrypted vault on your Mac, opened by a native app and the
          <span class="mono" style="color: var(--gold)">tess</span> command line. Offline, with no account.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={appStore} rel="noopener" aria-label="Download on the Mac App Store">
            <img src="/mac-app-store-badge.svg" alt="" width="156" height="40" class="badge-store" />
          </a>
          <div class="cmd" style="height: 3.1rem">
            <code><span class="p">$</span>{brewCmd}</code>
            <button type="button" data-copy={brewCmd} aria-label="Copy the Homebrew command">Copy</button>
          </div>
        </div>
        <p class="mt-5 text-sm faint">
          macOS 14 or later · Apache-2.0 · the CLI also runs on Linux
        </p>
      </div>
      <div class="hero-demo">
        <div class="hero-media" data-hero>
          <video data-hero-video autoplay muted playsinline loop preload="metadata" poster="/media/hero-poster.webp" width="1440" height="780" aria-label="tess in a terminal: adding an account from a QR image, copying a code, printing JSON, then the live watch view with countdown bars">
            <source src="/media/hero.webm" type="video/webm" />
            <source src="/media/hero.mp4" type="video/mp4" />
          </video>
          <img class="fallback" src="/media/hero-poster.webp" alt="tess printing the current codes for four accounts with countdown bars" width="1440" height="780" fetchpriority="high" />
        </div>
        <p class="mono text-xs faint mt-3">Recorded from the real CLI against a throwaway vault. Those secrets are not in use.</p>
      </div>
    </div>
  </section>

  <!-- ===== THE APP: cream, the window bleeds off the right edge ===== -->
  <section id="app" class="u-bleed-right app scroll-mt-20">
    <div class="app-copy">
      <h2 class="h-section">A native Mac app on the same vault.</h2>
      <p class="lede mt-5 measure">
        Live codes with countdown rings, one-click copy, on-screen QR scanning and Touch ID unlock.
        It opens a vault the CLI created, and the CLI keeps working on the same file.
      </p>
      <ul class="mt-7 space-y-2 soft">
        <li>TOTP, HOTP and Steam Guard.</li>
        <li>Imports otpauth links, Google Authenticator exports, and Aegis, 2FAS or Raivo files.</li>
        <li>Folders, pinning, and a short handle per account that both surfaces share.</li>
        <li>Clipboard contents are concealed and the window is excluded from screen capture.</li>
      </ul>
    </div>
    <AppShot class="app-shot" />
  </section>

  <!-- ===== ONE VAULT, TWO IMPLEMENTATIONS: sunken wide band ===== -->
  <section id="one-vault" class="band band-sunken one-vault">
    <div class="measure">
      <h2 class="h-display">One vault, two implementations.</h2>
      <p class="lede mt-6">
        The Go CLI and the Swift app are separate codebases that must open each other's files byte for byte.
        The contract is written down, pinned to test vectors, and checked in CI on every push.
      </p>
    </div>
    <div class="u-wide pillars">
      {pillars.map((x) => (
        <div class="pillar">
          <h3 class="h-sub">{x.h}</h3>
          <p class="mt-3 soft">{x.p}</p>
          <ul class="mt-4 space-y-1">
            {x.links.map(([href, label]) => (
              <li><a href={href} rel="noopener" class="mono text-[0.8rem]">{label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="mt-10 soft">
      The whole contract is on <a href="/vault-format">/vault-format</a>.
    </p>
  </section>

  <!-- ===== SECURITY YOU CAN READ: two-column reading rows ===== -->
  <section id="security" class="security">
    <div class="security-head">
      <h2 class="h-section">Security you can read.</h2>
      <p class="lede mt-4 measure">Each line links to the file that does it.</p>
    </div>
    <dl class="rows mt-10">
      {security.map((s) => (
        <div class="row">
          <dt>{s.t}</dt>
          <dd>
            {s.d}
            <span class="src">
              {s.links.map(([href, label], i) => (
                <>{i > 0 && " · "}<a href={href} rel="noopener">{label}</a></>
              ))}
            </span>
          </dd>
        </div>
      ))}
    </dl>
    <p class="mt-6 soft">
      More on <a href="/security">/security</a>, including what to do if you find something.
    </p>
  </section>

  <hr class="u-wide rule" />

  <!-- ===== INSTALL ===== -->
  <section id="install" class="install scroll-mt-20">
    <div class="install-head">
      <h2 class="h-sub">Install</h2>
      <p class="mt-3 soft measure">The app and the CLI are separate downloads. They share one vault once you open the CLI's file in the app, or set a recovery passphrase in the app's settings.</p>
    </div>
    <div class="install-grid mt-8">
      <div class="install-app">
        <h3 class="h-small">The Mac app</h3>
        <a href={appStore} rel="noopener" class="inline-block mt-4" aria-label="Download on the Mac App Store">
          <img src="/mac-app-store-badge.svg" alt="" width="156" height="40" class="badge-store" style="height: 3.4rem" />
        </a>
        <p class="mt-3 text-sm soft">macOS 14 or later. Version 1.0.2.</p>
      </div>
      <div class="install-cli">
        <h3 class="h-small">The <span class="mono">tess</span> CLI</h3>
        <dl class="rows mt-4">
          <div class="row">
            <dt>Homebrew</dt>
            <dd>
              <div class="cmd"><code><span class="p">$</span>{brewCmd}</code><button type="button" data-copy={brewCmd} aria-label="Copy the Homebrew command">Copy</button></div>
              <span class="src">Installs shell completions for bash, zsh and fish.</span>
            </dd>
          </div>
          <div class="row">
            <dt>Script</dt>
            <dd>
              <div class="cmd"><code><span class="p">$</span>{curlCmd}</code><button type="button" data-copy={curlCmd} aria-label="Copy the install script command">Copy</button></div>
              <span class="src">Downloads the release for your OS and architecture, checks its sha256 against checksums.txt, installs to /usr/local/bin or ~/.local/bin. <a href={`${blob}/install.sh`} rel="noopener">Read install.sh first</a>.</span>
            </dd>
          </div>
          <div class="row">
            <dt>Tarballs</dt>
            <dd>
              <ul class="space-y-2">
                {tarballs.map(([label, file, sha]) => (
                  <li>
                    <a href={`${releaseBase}/${file}`} rel="noopener">{label}</a>
                    <span class="block mono text-[0.72rem] faint break-all">sha256 {sha}</span>
                  </li>
                ))}
              </ul>
              <span class="src">v{cliVersion} · <a href={`${releaseBase}/checksums.txt`} rel="noopener">checksums.txt</a> · <a href={`${repo}/releases`} rel="noopener">all releases</a></span>
            </dd>
          </div>
          <div class="row">
            <dt>From source</dt>
            <dd>
              <div class="cmd"><code><span class="p">$</span>{goCmd}</code><button type="button" data-copy={goCmd} aria-label="Copy the go install command">Copy</button></div>
              <span class="src">Go 1.26 or later.</span>
            </dd>
          </div>
        </dl>
        <p class="mt-5 text-sm soft">
          Then <span class="mono">tess vault init</span>, <span class="mono">tess add</span>, <span class="mono">tess watch</span>.
          Vault path: <span class="mono">~/.local/share/tessera/vault.json</span>. The full reference is on <a href="/cli">/cli</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== THE OTHERS ===== -->
  <section id="compare" class="band band-sunken compare">
    <div class="measure">
      <h2 class="h-sub">Compared with the others</h2>
    </div>
    <dl class="rows mt-8">
      {others.map(([name, line, href]) => (
        <div class="row">
          <dt>{name}</dt>
          <dd>
            {line}
            {href && <span class="src"><a href={href}>{`Tessera vs ${name}`}</a></span>}
          </dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- ===== CLOSE ===== -->
  <section class="close">
    <h2 class="h-display">All of it, free.</h2>
    <p class="lede mt-5 measure">The app and the CLI, with nothing to buy.</p>
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a href={appStore} rel="noopener" aria-label="Download on the Mac App Store">
        <img src="/mac-app-store-badge.svg" alt="" width="156" height="40" class="badge-store" />
      </a>
      <div class="cmd" style="height: 3.1rem">
        <code><span class="p">$</span>{brewCmd}</code>
        <button type="button" data-copy={brewCmd} aria-label="Copy the Homebrew command">Copy</button>
      </div>
    </div>
  </section>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(softwareLd)} />
</Base>

<style>
  .hero-band { overflow: hidden; }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    padding-block: 3.5rem 3rem;
    align-items: center;
  }
  .hero-copy { padding-right: var(--gap); }
  .hero-demo { padding-right: var(--gap); }
  @media (min-width: 1024px) {
    .hero {
      grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
      gap: 3.5rem;
      padding-block: 5.5rem 5rem;
    }
    .hero-demo { padding-right: 0; width: calc(100% + 3rem); }
    .hero-media { border-radius: 0.9rem 0 0 0.9rem; }
  }

  .app {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    padding-block: 5rem 0;
    align-items: end;
    position: relative;
    z-index: 1;
  }
  .app-copy { padding-right: var(--gap); padding-bottom: 2rem; }
  .app-copy li { padding-left: 1.1rem; position: relative; }
  .app-copy li::before { content: ""; position: absolute; left: 0; top: 0.72em; width: 0.45rem; height: 0.45rem; border-radius: 2px; background: var(--gold); }
  @media (min-width: 900px) {
    .app { grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr); gap: 4rem; padding-block: 6.5rem 0; }
    .app-copy { padding-bottom: 6rem; }
  }

  .one-vault { padding-block: 6rem 5rem; }
  @media (min-width: 900px) { .one-vault { padding-top: 9rem; } }
  .pillars { display: grid; gap: 2rem; margin-top: 3.5rem; }
  .pillar { padding-top: 1.5rem; border-top: 1px solid var(--line-strong); }
  @media (min-width: 900px) {
    .pillars { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; }
    .pillar { border-top: 0; border-left: 1px solid var(--line-strong); padding: 0.25rem 2rem 0 2rem; }
    .pillar:first-child { padding-left: 0; border-left: 0; }
  }

  .security { padding-block: 6rem 4rem; }
  .rule { border: 0; border-top: 1px solid var(--line); margin: 0; }
  .install { padding-block: 4.5rem 5rem; }
  .install-grid { display: grid; gap: 3rem; }
  @media (min-width: 900px) { .install-grid { grid-template-columns: minmax(0, 0.55fr) minmax(0, 1.45fr); gap: 4rem; } }
  .install .row { grid-template-columns: 1fr; }
  @media (min-width: 720px) { .install .row { grid-template-columns: minmax(8rem, 0.25fr) 1fr; } }
  .install .row > dd { max-width: none; }

  .compare { padding-block: 5rem; }
  .close { padding-block: 7rem 6rem; }
</style>

<script is:inline>
  (() => {
    const v = document.querySelector("[data-hero-video]");
    if (!v) return;
    const p = v.play();
    if (p && p.catch) p.catch(() => v.closest("[data-hero]")?.setAttribute("data-video-blocked", ""));
  })();
</script>
