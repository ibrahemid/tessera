---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import HeroVideo from "../components/HeroVideo.astro";
import cli from "../data/cli.json";
import { HAS_LINUX_PACKAGES, IS_VAULT_V2_RELEASED } from "../data/release";

const repo = "https://github.com/ibrahemid/tessera";
const blob = `${repo}/blob/main`;

const quickStart = [
  ["create an encrypted vault", "tess vault init"],
  ["add from an otpauth link", 'tess add "otpauth://totp/ACME:me@x.com?secret=JBSWY3DPEHPK3PXP&issuer=ACME"'],
  ["from a QR image", "tess add code.png"],
  ["select a QR code on screen (macOS, Linux)", "tess add --screen"],
  ["Google Authenticator export", 'tess import --migration "otpauth-migration://offline?data=..."'],
  ["another app's export, recognized by content", "tess import aegis-export.json"],
  ["read the input from stdin, as tess add - does too", "cat export.json | tess import -"],
  ["current codes with countdown bars", "tess"],
  ["live view: / search, enter or c copy, q quit", "tess watch"],
  ["one account's code, copied to the clipboard", "tess acme"],
  ["by handle, as shown by tess list, printed only", "tess ac --no-copy"],
  ["copy, then clear the clipboard after 30s", "tess code acme --clear 30"],
  ["set a handle", "tess alias ac work"],
  ["machine-readable", "tess code --json"],
  ["store the passphrase in the system secret store", "tess vault remember"],
  ["path, file details, unlock methods, backups, secret store", "tess vault status"],
  ["encrypted copy of the vault", "tess export --file backup.json"],
  ["the vault in another app's export format", "tess export --format aegis --out aegis.json"],
  ["reconcile two vaults, writing both", "tess merge --two-way ~/other.json"],
];

const commands = cli.commands.filter((c) => c.name !== "completion");
const completion = cli.commands.find((c) => c.name === "completion");
const shells = completion ? completion.subcommands : [];

const JSON_FLAG = /^\s+--json\b/m;
const jsonCommands = cli.commands.flatMap((c) => [
  ...(JSON_FLAG.test(c.help) ? [`tess ${c.name}`] : []),
  ...c.subcommands.filter((s) => JSON_FLAG.test(s.help)).map((s) => `tess ${c.name} ${s.name}`),
]);

const esc = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const inline = (t: string) => esc(t).replace(/`([^`]+)`/g, '<span class="mono">$1</span>');

const quickStartHtml = quickStart
  .map(([note, cmd]) => `<span class="c"># ${esc(note)}</span>\n<span class="p">$ </span>${esc(cmd)}`)
  .join("\n");
const jsonHtml = `<span class="p">$ </span>${esc(cli.jsonSample.command)}\n${esc(cli.jsonSample.output)}`;

type CompletionLine = { label: string; cmd: string };
function completionLinesFor(shell: { name: string; help: string }): CompletionLine[] {
  const lines = shell.help.split("\n");
  const commandsAfter = (marker: string) => {
    const start = lines.findIndex((l) => l.startsWith(marker));
    if (start < 0) return [];
    const found: CompletionLine[] = [];
    let os = "";
    for (const l of lines.slice(start + 1)) {
      if (l.startsWith("Usage:")) break;
      const heading = l.match(/^#### (.+):$/);
      if (heading) os = heading[1];
      else if (l.startsWith("\t")) found.push({ label: os ? `${shell.name}, ${os}` : shell.name, cmd: l.trim() });
    }
    return found;
  };
  const everySession = commandsAfter("To load completions for every new session");
  if (everySession.length > 0) return everySession;
  return commandsAfter("To load completions in your current shell session").slice(0, 1).map((l) => ({ ...l, label: `${shell.name}, current session` }));
}
const needsBashCompletion = (help: string) => help.includes("depends on the 'bash-completion' package");
const completionsHtml = shells
  .flatMap((s) => completionLinesFor(s).map((l) => {
    const note = s.name === "bash" && needsBashCompletion(s.help) ? `${l.label} (needs bash-completion)` : l.label;
    const prompt = s.name === "powershell" ? "PS> " : "$ ";
    return `<span class="c"># ${esc(note)}</span>\n<span class="p">${prompt}</span>${esc(l.cmd)}`;
  }))
  .join("\n");
const hasPowershell = shells.some((s) => s.name === "powershell");

const env = cli.environment;
const vault = cli.vaultLocation;
const [vaultFileNote, ...vaultSecretNotes] = vault.notes;
---
<Base
  title="tess command line · Tessera"
  description="The tess reference: every subcommand's help text, JSON output for scripts, shell completions, environment variables and file locations."
  current="/cli"
>
  <PageHead kicker="Command line" title="tess, the whole reference.">
    The help text on this page is generated from the tess binary, so it matches what
    <span class="mono">tess help</span> prints. How to install is on <a href="/#install">the install section</a>.
    <HeroVideo
      slot="media"
      src="/media/hero"
      poster="/media/hero-poster.webp"
      width={1280}
      height={720}
      alt="tess in a terminal: the live watch view with five accounts, codes and full countdown bars, then adding GitHub from a QR image, copying its code and printing it as JSON"
    />
  </PageHead>

  <div class="u-wide docs">
    <nav class="toc" aria-label="On this page">
      <p class="kicker">Contents</p>
      <ul class="mt-3">
        <li><a href="#quick-start">Quick start</a></li>
        <li><a href="#reference">Reference</a>
          <ul>
            {commands.map((c) => <li><a href={`#${c.name}`}>{c.name}</a></li>)}
          </ul>
        </li>
        <li><a href="#json">JSON output</a></li>
        <li><a href="#completions">Completions</a></li>
        <li><a href="#environment">Environment</a></li>
        <li><a href="#files">Files</a></li>
      </ul>
    </nav>

    <div class="doc">
      <section id="quick-start" class="scroll-mt-20">
        <h2 class="h-sub">Quick start</h2>
        <pre class="term wrap mt-5"><code set:html={quickStartHtml} /></pre>
        <p class="mt-4 soft">
          <span class="mono">tess import</span> reads unencrypted exports from Aegis, 2FAS, Raivo, andOTP, FreeOTP+, Stratum, Bitwarden and Bitwarden Authenticator, Proton Authenticator, Ente Auth, Apple Passwords and 1Password, plus Google Authenticator transfer QR codes. <span class="mono">tess export --format</span> writes Aegis, 2FAS, Bitwarden Authenticator, Proton Authenticator, andOTP, Apple Passwords CSV and Google Authenticator QR codes back out.
        </p>
        <p class="mt-4 soft">
          Accounts resolve by exact handle, then exact issuer or account name, then a unique substring. When more than one account matches, tess lists them with their handles instead of guessing.
        </p>
        <p class="mt-4 soft">
          <span class="mono">tess acme</span> is short for <span class="mono">tess code acme</span>; a subcommand name always wins over an account handle. On a terminal the code is copied as well as printed; piped or with <span class="mono">--json</span> tess prints the digits and leaves the clipboard alone, unless you pass <span class="mono">-c</span>. <span class="mono">--no-copy</span> turns the copy off, and <span class="mono">--clear</span> wipes it after a delay, only while the clipboard still holds that code. A code with under four seconds left is held back until the next one unless you pass <span class="mono">--now</span>.
        </p>
      </section>

      <section id="reference" class="mt-16 scroll-mt-20">
        <h2 class="h-sub">Reference</h2>
        <p class="mt-3 soft">Global flag: <span class="mono">--vault</span> sets the vault file for any command. With no argument, <span class="mono">tess</span> prints current codes for every account; with one, it prints and copies that account's code.</p>
        <pre class="term mt-5"><code>{cli.root}</code></pre>
        {commands.map((c) => (
          <article id={c.name} class="mt-12 scroll-mt-20">
            <h3 class="h-small mono">tess {c.name}</h3>
            <pre class="term mt-3"><code>{c.help}</code></pre>
            {c.subcommands.map((s) => (
              <div id={`${c.name}-${s.name}`} class="mt-5 ml-0 sm:ml-6 scroll-mt-20">
                <h4 class="mono text-[0.95rem]">tess {c.name} {s.name}</h4>
                <pre class="term mt-2"><code>{s.help}</code></pre>
              </div>
            ))}
          </article>
        ))}
      </section>

      <section id="json" class="mt-16 scroll-mt-20">
        <h2 class="h-sub">JSON output</h2>
        <p class="mt-3 soft">
          With <span class="mono">--json</span>, these commands print JSON for scripts:
          {jsonCommands.map((c, i) => <>{i > 0 && ", "}<span class="mono">{c}</span></>)}. One account:
        </p>
        <pre class="term wrap mt-5"><code set:html={jsonHtml} /></pre>
        <p class="mt-4 soft">
          Without a query, <span class="mono">tess code --json</span> prints an array. Set <span class="mono">TESSERA_PASSPHRASE</span> to avoid the prompt, or run <span class="mono">tess vault remember</span> once. Errors go to stderr as text, with a non-zero exit status. Every field is listed in <a href={`${blob}/docs/CLI-JSON.md`} rel="noopener">docs/CLI-JSON.md</a>.
        </p>
      </section>

      <section id="completions" class="mt-16 scroll-mt-20">
        <h2 class="h-sub">Shell completions</h2>
        <p class="mt-3 soft">Once per shell. Completing an account name reads the vault, so handles are offered once it opens without a prompt, from <span class="mono">TESSERA_PASSPHRASE</span> or the system secret store.{HAS_LINUX_PACKAGES && " The Linux packages install the bash, zsh and fish scripts."}</p>
        <pre class="term wrap mt-5"><code set:html={completionsHtml} /></pre>
        {hasPowershell && (
          <p class="mt-4 soft">On Windows, add the output of <span class="mono">tess completion powershell</span> to your PowerShell profile to load it in every session.</p>
        )}
        {shells.map((s) => (
          <details class="mt-4">
            <summary class="mono text-[0.9rem] cursor-pointer">tess completion {s.name} --help</summary>
            <pre class="term mt-3"><code>{s.help}</code></pre>
          </details>
        ))}
      </section>

      <section id="environment" class="mt-16 scroll-mt-20">
        <h2 class="h-sub">Environment</h2>
        <dl class="rows mt-5">
          {env.variables.map((v) => (
            <div class="row">
              <dt class="mono">{v.name}</dt>
              <dd set:html={inline(v.effect)} />
            </div>
          ))}
        </dl>
        {env.notes.map((n) => <p class="mt-4 soft" set:html={inline(n)} />)}
      </section>

      <section id="files" class="mt-16 mb-24 scroll-mt-20">
        <h2 class="h-sub">Files</h2>
        <dl class="rows mt-5">
          <div class="row">
            <dt>Vault</dt>
            <dd>
              <p set:html={inline(vault.lead)} />
              <ul class="mt-2 paths">
                {vault.platforms.map((p) => <li><span class="os">{p.os}:</span> <span set:html={inline(p.path)} /></li>)}
              </ul>
              {vaultFileNote && <p class="mt-3" set:html={inline(vaultFileNote)} />}
              <p class="mt-3">The Mac app can open this same file: choose Use a vault created by the tess CLI on its empty window, or Use another vault file in Settings, Vault. The app remembers it. Format on <a href="/vault-format">/vault-format</a>.</p>
              {IS_VAULT_V2_RELEASED && (
                <p class="mt-3">tess 1.2.0 writes version 2 of the format once an account is in the Trash (<span class="mono">tess rm</span>, <span class="mono">tess dedupe</span>), has a note (<span class="mono">tess note</span>) or a position (<span class="mono">tess order</span>), or comes in from <span class="mono">tess import</span> with a note. The Mac app 1.1.0 and tess 1.1.0 refuse to open a version 2 vault, so nothing in it is lost; tess 1.2.0 keeps working with it. The vault goes back to version 1 once the Trash is empty (<span class="mono">tess restore</span>, <span class="mono">tess trash empty</span>) and no account has a note or a position (<span class="mono">tess note --clear</span>, <span class="mono">tess order --clear</span>).</p>
              )}
            </dd>
          </div>
          <div class="row">
            <dt>Backups</dt>
            <dd>With <span class="mono">TESSERA_BACKUP_DIR</span> set, every change to the vault writes <span class="mono">tessera-backup-YYYYMMDD.json</span> there; the folder keeps the 30 newest. <a href="#vault-backup">tess vault backup</a> writes one on demand.</dd>
          </div>
          {vaultSecretNotes.length > 0 && (
            <div class="row">
              <dt>Passphrase</dt>
              <dd>{vaultSecretNotes.map((n, i) => <p class={i > 0 ? "mt-3" : undefined} set:html={inline(n)} />)}</dd>
            </div>
          )}
          <div class="row">
            <dt>Source</dt>
            <dd><a href={`${blob}/go/cmd/tess`} rel="noopener">go/cmd/tess</a> is the command layer; <a href={`${blob}/go/internal`} rel="noopener">go/internal</a> holds the vault, OTP, otpauth and import code.</dd>
          </div>
        </dl>
      </section>
    </div>
  </div>
</Base>

<style>
  .docs { display: grid; gap: 3rem; padding-bottom: 2rem; }
  .doc { max-width: 72ch; min-width: 0; }
  .toc { font-size: 0.9rem; }
  .toc ul ul { margin: 0.3rem 0 0.5rem 0.9rem; columns: 2; }
  .toc li { line-height: 1.9; }
  .toc a { color: var(--ink-soft); }
  .toc a:hover { color: var(--ink); }
  @media (max-width: 1023px) {
    .toc ul ul { columns: 3; }
    .toc li { line-height: 1.4; }
    .toc a { display: inline-flex; align-items: center; min-height: 44px; min-width: 44px; }
  }
  @media (min-width: 1024px) {
    .docs { grid-template-columns: 13rem minmax(0, 1fr); gap: 4rem; }
    .toc { position: sticky; top: 5.5rem; align-self: start; }
    .toc ul ul { columns: 1; }
  }
  pre.term { white-space: pre; }
  pre.term.wrap { white-space: pre-wrap; overflow-wrap: anywhere; }
  @media (min-width: 720px) {
    .doc .row { grid-template-columns: minmax(max-content, 0.38fr) minmax(0, 1fr); }
  }
  .paths li { overflow-wrap: anywhere; }
  .paths li + li { margin-top: 0.35rem; }
  .paths .os { color: var(--ink); }
</style>
